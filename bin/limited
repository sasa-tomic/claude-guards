#!/usr/bin/env bash
# Run a command in a memory/CPU-capped transient systemd scope; every descendant process shares the caps, so a runaway
# job is killed instead of freezing the machine. Needs Linux, cgroup v2 and a systemd user session.
# usage: limited [-m GB] [-t DURATION] [-i DURATION] [-c CORES] [--] cmd args...
#        limited extend PID|UNIT DURATION    set a running job's deadline to now + DURATION (PID: any process of the job)
#        limited ls                          running jobs: unit, pid, elapsed, time left, cores, command
#   -m GB        memory cap of this job (default: 65% of MemTotal, the cap of all jobs together; at most that)
#   -t DURATION  runtime deadline (default 1h). Durations: 90s, 30m, 6h, 2d or infinity. One stderr warning
#                ("limited: deadline in ...") when 10 min or, for short runs, half the run is left, so the caller can
#                extend; again after each extend. systemd cannot change RuntimeMaxSec of a running scope, so limited
#                enforces the deadline itself.
#   -i DURATION  idle kill (default $LIMITED_IDLE or 0 = off): kill the job when its whole process tree used < CORES
#                over the last DURATION, so a stalled job ends with exit 124 instead of waiting unseen.
#   -c CORES     stall threshold of the idle kill and the cpu warning (default 0.05 cores)
# Cpu warning: at the first sample, then every 3 samples, a stderr line "limited: cpu: ..." when over that span
# the job used < CORES (stalled) or at least a quarter of the machine's cores sat idle (the job could use more).
# Both kills stop the scope, print "limited: killed: <reason>" on stderr and exit 124. Sampling every
# LIMITED_SAMPLE_S (10) s.
# All jobs run in claude-limited.slice; each launch sets its caps at runtime (MemoryMax 65% of MemTotal, no swap,
# CPUWeight 50, no MemoryHigh), so no unit file is needed. A scope gets the same memory cap with no swap, all cores
# but 2, and choom -n 1000 (inherited by every descendant): the kernel OOM killer takes a limited job before anything
# else. No MemoryHigh: without swap it throttles every job into an endless stall below MemoryMax instead of killing
# the runaway.
# OMP_WAIT_POLICY defaults to PASSIVE: OpenMP threads (numpy BLAS, LightGBM) busy-wait by default, which on an
# oversubscribed machine made 10 LightGBM trees take 42 s instead of 0.5 s. A caller's own value is kept.
# Tests: bin/limited.test.sh
set -euo pipefail
state=${XDG_RUNTIME_DIR:?}/limited
ncpu=$(grep -c '^cpu[0-9]' /proc/stat)
total=$(awk '$1 == "MemTotal:" { print int($2 * 0.65 / 1048576) }' /proc/meminfo)

# seconds of a duration, -1 for infinity; refuses anything else
secs() {
  [[ $1 == infinity ]] && { echo -1; return; }
  [[ $1 =~ ^([0-9]+)([smhd])$ ]] || { echo "limited: duration '$1' is not like 90s, 30m, 6h, 2d or infinity" >&2; return 2; }
  local n=${BASH_REMATCH[1]}
  case ${BASH_REMATCH[2]} in s) echo "$n" ;; m) echo $((n * 60)) ;; h) echo $((n * 3600)) ;; d) echo $((n * 86400)) ;; esac
}

if [[ ${1:-} == extend ]]; then
  [[ $# -eq 3 ]] || { echo "usage: limited extend PID|UNIT DURATION" >&2; exit 2; }
  s=$(secs "$3") || exit 2
  if [[ $2 =~ ^[0-9]+$ ]]; then
    unit=$(sed -n 's|.*/\(limited-[0-9]*-[0-9]*\)\.scope$|\1|p' "/proc/$2/cgroup" 2>/dev/null) || true
    [[ -n $unit ]] || { echo "limited: process $2 is not in a limited job" >&2; exit 1; }
  else unit=$2; fi
  [[ -f $state/$unit.deadline ]] || { echo "limited: no running job $unit" >&2; exit 1; }
  (( s < 0 )) && d=-1 || d=$((EPOCHSECONDS + s))
  echo "$d" > "$state/$unit.deadline.tmp" && mv "$state/$unit.deadline.tmp" "$state/$unit.deadline"
  echo "limited: $unit deadline $( (( d < 0 )) && echo infinity || date -d "@$d" '+%F %T %Z')"
  exit 0
fi
if [[ ${1:-} == ls ]]; then
  printf '%-24s %-8s %-9s %-9s %-6s %s\n' unit pid elapsed left cores command
  for f in "$state"/*.deadline; do
    [[ -e $f ]] || continue
    u=$(basename "$f" .deadline); read -r pid start cmd < "$state/$u.info"; d=$(<"$f")
    stat=/sys/fs/cgroup$(sed -n 's/^0:://p' "/proc/$pid/cgroup" 2>/dev/null)/cpu.stat
    u0=$(awk '$1 == "usage_usec" { print $2 }' "$stat" 2>/dev/null) || continue; sleep 1
    u1=$(awk '$1 == "usage_usec" { print $2 }' "$stat" 2>/dev/null) || continue
    printf '%-24s %-8s %-9s %-9s %-6s %s\n' "$u" "$pid" "$(( (EPOCHSECONDS - start) / 60 ))m" \
      "$( (( d < 0 )) && echo inf || echo "$(( (d - EPOCHSECONDS) / 60 ))m")" "$(( (u1 - u0) / 10000 ))%" "$cmd"
  done
  exit 0
fi

max=$total runtime=1h idle=${LIMITED_IDLE:-0} floor=0.05
while [[ ${1:-} == -[mtic] ]]; do
  case $1 in
    -m) [[ ${2:-} =~ ^[0-9]+$ ]] && (( $2 <= total )) || { echo "limited: -m needs integer GB up to $total (65% of MemTotal)" >&2; exit 2; }; max=$2 ;;
    -t) secs "${2:-}" >/dev/null || exit 2; runtime=$2 ;;
    -i) idle=${2:-} ;;
    -c) [[ ${2:-} =~ ^[0-9]*\.?[0-9]+$ ]] || { echo "limited: -c needs a number of cores" >&2; exit 2; }; floor=$2 ;;
  esac
  shift 2
done
[[ $idle == 0 ]] || { secs "$idle" >/dev/null && [[ $idle != infinity ]]; } || { echo "limited: -i (or LIMITED_IDLE) needs a duration or 0" >&2; exit 2; }
[[ ${1:-} == -- ]] && shift
[[ $# -gt 0 ]] || { echo "usage: limited [-m GB] [-t DURATION] [-i DURATION] [-c CORES] [--] cmd args..." >&2; exit 2; }
systemctl --user set-property --runtime claude-limited.slice MemoryMax="${total}G" MemoryHigh=infinity MemorySwapMax=0 CPUWeight=50
sample=${LIMITED_SAMPLE_S:-10}
[[ $idle == 0 ]] && iwin=0 || iwin=$(secs "$idle")
unit=limited-$$-$RANDOM
cg=/sys/fs/cgroup$(systemctl --user show claude-limited.slice -p ControlGroup --value)/$unit.scope
mkdir -p "$state"
rt=$(secs "$runtime"); (( rt < 0 )) && echo -1 > "$state/$unit.deadline" || echo $((EPOCHSECONDS + rt)) > "$state/$unit.deadline"

# One sample: "<epoch s> <job cpu usec> <machine idle jiffies> <machine total jiffies>"; job usage USEC if given
probe() {
  local usec=${1:-}
  [[ -n $usec ]] || usec=$(awk '$1 == "usage_usec" { print $2 }' "$cg/cpu.stat" 2>/dev/null) || return 1
  [[ -n $usec ]] || return 1
  awk -v t="$EPOCHREALTIME" -v u="$usec" '$1 == "cpu" { tot = 0; for (i = 2; i <= NF; i++) tot += $i
    print t, u, $5 + $6, tot; exit }' /proc/stat
}

# "<job cores> <machine idle cores>" between samples A and B
rates() {
  awk -v a="$1" -v b="$2" -v n="$ncpu" 'BEGIN { split(a, x); split(b, y)
    printf "%.2f %.1f", (y[2] - x[2]) / 1e6 / (y[1] - x[1]), (y[3] - x[3]) / (y[4] - x[4]) * n }'
}

# kill the job for REASON: the reason file tells the main process why it ended
stop() { echo "$1" > "$state/$unit.killed"; systemctl --user stop "$unit.scope" 2>/dev/null || true; }

# Enforce the deadline and the idle kill, warn about cpu use, until the job ends.
watch() {
  local pid=$1 cmd=$2 s=() line d keep n0 warned=0 job idl mark=1 since
  keep=$(( iwin / sample + 1 ))
  # baseline at launch: the new scope has used no cpu yet
  since=$(probe 0)
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$sample" </dev/null >/dev/null 2>&1
    d=$(<"$state/$unit.deadline")
    (( d < 0 || EPOCHSECONDS < d )) || { stop "past its deadline ($runtime, or as extended); extend it with: limited extend $pid DURATION"; return; }
    if (( d > 0 && warned != d && d - EPOCHSECONDS <= (rt / 2 < 600 ? rt / 2 : 600) )); then
      echo "limited: deadline in $(( d - EPOCHSECONDS ))s; extend it with: limited extend $pid DURATION ($cmd)" >&2; warned=$d
    fi
    line=$(probe) || continue
    s+=("$line"); (( ${#s[@]} <= keep )) || s=("${s[@]: -$keep}")
    n0=$(( ${#s[@]} - 1 - iwin / sample ))
    if (( iwin > 0 && n0 >= 0 )); then
      read -r job idl <<< "$(rates "${s[$n0]}" "${s[-1]}")"
      awk -v c="$job" -v f="$floor" 'BEGIN { exit !(c < f) }' && { stop "idle: $job cores over the last $idle (floor $floor)"; return; }
    fi
    (( --mark > 0 )) && continue
    read -r job idl <<< "$(rates "$since" "$line")"
    awk -v c="$job" -v f="$floor" -v i="$idl" -v n="$ncpu" 'BEGIN { exit !(c < f || i >= n / 4) }' &&
      echo "limited: cpu: job used $job cores, $idl of $ncpu cores idle over $(( ${line%%.*} - ${since%%.*} ))s ($cmd)" >&2
    since=$line mark=3
  done
}

export OMP_WAIT_POLICY=${OMP_WAIT_POLICY:-PASSIVE}
systemd-run --user --scope --quiet --collect --expand-environment=no --slice=claude-limited.slice --unit="$unit" \
  -p MemoryMax="${max}G" -p MemorySwapMax=0 -p OOMPolicy=kill -p CPUQuota=$(( (ncpu > 3 ? ncpu - 2 : 1) * 100 ))% \
  -p CPUWeight=50 -p TasksMax=2048 -- choom -n 1000 -- "$@" <&0 &
job=$!
echo "$job $EPOCHSECONDS $*" > "$state/$unit.info"
trap 'kill -TERM $job 2>/dev/null' INT TERM HUP
watch "$job" "$1" &
watcher=$!
rc=0
wait "$job" || rc=$?
# a trapped signal interrupts wait while the job still runs down: wait again for its real exit code
while kill -0 "$job" 2>/dev/null; do wait "$job" || rc=$?; done
kill "$watcher" 2>/dev/null || true
wait "$watcher" 2>/dev/null || true
if [[ -f $state/$unit.killed ]]; then echo "limited: killed: $(<"$state/$unit.killed") ($*)" >&2; rc=124; fi
rm -f "$state/$unit".{deadline,info,killed}
exit "$rc"
