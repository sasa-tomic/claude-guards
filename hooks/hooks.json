{
  "hooks": {
    "PreToolUse": [
      { "matcher": "^Bash$", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/refuse-detached-bash.sh\"" }] },
      { "matcher": "^Agent$", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/require-subagent-model.sh\"" }] }
    ]
  }
}
